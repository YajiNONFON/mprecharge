generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}




// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  first_name    String
  last_name     String
  email         String   @unique
  phone         String   @unique
  password_hash String
  role          Role     @default(CLIENT)
  acceptTerms   Boolean  @default(false)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  referralCode  String?  @unique
  pointsBalance Int      @default(0)


  profile             Profile?
  transactions        Transaction[]
  notifications       Notification[]
  paymentMethods      PaymentMethod[]
  contacts            Contact[]
  passwordResetTokens PasswordResetToken[]
  userSessions        UserSession[]
  referralsSent       Referral[]           @relation("ReferrerRelation")
  referralsReceived   Referral[]           @relation("ReferredRelation")
  pointTransactions   PointTransaction[]
  referralPayouts     ReferralPayout[]
}

// ─────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  device       String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  publicId          String   @unique
  profileImage      String?
  activeServiceId   String?
  activeService     Service? @relation(fields: [activeServiceId], references: [id])
  platformAccountId String?  
  oneXbetId         String?  
  mtnNumber         String?
  moovNumber        String?
  celtiisNumber     String?
  orangeNumber      String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
// SERVICE
// ─────────────────────────────────────────

model Service {
  id          String  @id @default(uuid())
  name        String
  displayName String
  description String?
  apiBaseUrl  String?
  isActive    Boolean  @default(true)
  activeGateway Gateway @default(FEEXPAY)
  created_at  DateTime @default(now())

  transactions  Transaction[]
  notifications Notification[]
  profiles      Profile[]
}

// ─────────────────────────────────────────
// TRANSACTION
// ─────────────────────────────────────────

model Transaction {
  id             String             @id @default(uuid())
  userId         String
  serviceId      String
  transpublicId  String?            @unique
  type           TransactionsType
  amount         Float
  netAmount      Float?
  fees           Float?
  status         TransactionsStatus @default(PENDING)
  paymentNumber  String?
  withdrawalCode String?
  accountId      String?
  networkType    String?
  receiverNumber String?
  providerRef    String?
  clientFullName String?
  notes          String?
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  pointTransactions PointTransaction[]
  logs              TransactionLog[]
}

// ─────────────────────────────────────────
// PARRAINAGE
// ─────────────────────────────────────────

model Referral {
  id          String         @id @default(uuid())
  referrerId  String
  referredId  String
  status      ReferralStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  validatedAt DateTime?

  referrer          User               @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referred          User               @relation("ReferredRelation", fields: [referredId], references: [id])
  pointTransactions PointTransaction[]
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PointTransaction {
  id            String      @id @default(uuid())
  userId        String
  referralId    String?
  transactionId String?
  payoutId      String?
  type          PointTxType
  points        Int
  createdAt     DateTime    @default(now())

  user        User            @relation(fields: [userId], references: [id])
  referral    Referral?       @relation(fields: [referralId], references: [id])
  transaction Transaction?    @relation(fields: [transactionId], references: [id])
  payout      ReferralPayout? @relation(fields: [payoutId], references: [id])
}

model ReferralPayout {
  id              String   @id @default(uuid())
  userId          String
  pointsConverted Int
  amountPaid      Float
  paidAt          DateTime @default(now())
  paidByAdminId   String

  user              User               @relation(fields: [userId], references: [id])
  pointTransactions PointTransaction[]
}

// ─────────────────────────────────────────
// AUTRES MODÈLES
// ─────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  userId     String
  serviceId  String
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  created_at DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  userId     String
  network    String
  number     String
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id           String   @id @default(uuid())
  userId       String
  hashed_token String   @unique
  expires_at   DateTime
  used         Boolean  @default(false)
  created_at   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Promo {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

}

model TransactionLog {
  id            String             @id @default(uuid())
  transactionId String
  step          PipelineStep
  status        PipelineStepStatus
  message       String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Contact {
  id                  String        @id @default(uuid())
  userId              String
  email               String
  subject             String
  message             String
  handled_by_admin_id String?
  status              ContactStatus @default(PENDING)
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum TransactionsType {
  DEPOSIT
  WITHDRAWAL
}

enum Role {
  CLIENT
  ADMIN
  SUPER_ADMIN
  ADMIN_DEV
}

enum Gateway {
  FEEXPAY
  FEDAPAY
}

enum TransactionsStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  SUCCESS
  ERROR
  INFO
  WARNING
}

enum ContactStatus {
  PENDING
  HANDLED
  CLOSED
}

enum ReferralStatus {
  PENDING
  VALIDATED
}

enum PointTxType {
  EARN
  WELCOME
  CONVERT
}

enum PipelineStep {
  INITIATED
  GATEWAY_PENDING
  GATEWAY_CONFIRMED
  MOCASH_CREDIT
  MOCASH_DEBIT
  ADMIN_PROCESS
  COMPLETED
}

enum PipelineStepStatus {
  SUCCESS
  FAILED
  PENDING
}